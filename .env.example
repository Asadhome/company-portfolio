# The contact form (app/api/contact/route.ts) sends through Resend.
# Without RESEND_API_KEY set, submissions are logged instead of sent, so the
# form still works end-to-end in local dev with no keys configured.

# Required to actually send messages. Get one at https://resend.com/api-keys.
RESEND_API_KEY=

# Optional — where contact form messages are delivered.
# Defaults to company.email in lib/content.ts.
CONTACT_TO_EMAIL=createpixl55@gmail.com

# Optional — the "from" address on outgoing messages.
# Defaults to Resend's shared "onboarding@resend.dev" sender, which only
# delivers to the email address your Resend account signed up with. Verify a
# domain in the Resend dashboard and point this at an address on it (e.g.
# "createpixel <hello@createpixel.co>") before relying on this for real
# inquiries.
# CONTACT_FROM_EMAIL="createpixel <hello@createpixel.co>"

# Optional — used to build an absolute URL for the social-preview (og:image)
# once a real domain is live. Vercel deployments fall back to VERCEL_URL
# automatically, so this usually only needs setting for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://createpixel.co

# Gmail SMTP (easiest): GMAIL_USER is the sending Gmail account; the password
# is a Google App Password (Google Account -> Security -> 2-Step Verification
# -> App passwords), NOT your normal Gmail password.
GMAIL_USER=createpixl55@gmail.com
GMAIL_APP_PASSWORD=
